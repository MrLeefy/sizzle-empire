{
  "name": "sizzle-empire",
  "private": true,
  "version": "1.0.0",
  "description": "Sizzle Empire — Stylized 3D Idle Restaurant Tycoon PWA & Capacitor Android Game",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "lab": "vite --host 0.0.0.0 --open /tools/character-lab.html",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim:economy": "tsx tools/simulate-economy.ts",
    "cap:sync": "npm run build && npx cap sync android",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "break_infinity.js": "^2.2.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.178.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.178.0",
    "@vitejs/plugin-react": "^4.5.0",
    "fake-indexeddb": "^6.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.1.4"
  }
}
